<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Belgian eID and esign</title>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64" rootVolumeOnly="true"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="@MIN_OS@"/>
        </allowed-os-versions>
    </volume-check>
    <readme file="CombinedReadMe.html"/>
    <license file="CombinedLicense.html"/>
    <choices-outline>
        <line choice="middleware"/>
        <line choice="beidtoken"/>
        <line choice="esign"/>
    </choices-outline>
    <choice id="middleware" visible="false"><pkg-ref id="be.eid.middleware"/></choice>
    <choice id="beidtoken" visible="false"><pkg-ref id="be.eid.BEIDtoken.app"/></choice>
    <choice id="esign" visible="false"><pkg-ref id="com.zetes.bosa-pc-signing-macos"/></choice>
    <pkg-ref id="be.eid.middleware" onConclusion="none">beidbuild.pkg</pkg-ref>
    <pkg-ref id="be.eid.BEIDtoken.app" onConclusion="none">BEIDToken.pkg</pkg-ref>
    <pkg-ref id="com.zetes.bosa-pc-signing-macos" onConclusion="none">BeIDSignComponent.pkg</pkg-ref>
</installer-gui-script>
